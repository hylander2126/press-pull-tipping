---
// Interactive wrench and torque-fit plots (Plotly). Data come from src/data/wrench_<obj>.json
// (one representative trial) and results.json (all-trial per-sweep stats), both generated by
// code/tools/export_web_data.py. The object selector stays in sync with the Object Explorer tabs.
import box from "../data/wrench_box.json";
import heart from "../data/wrench_heart.json";
import flashlight from "../data/wrench_flashlight.json";
import monitor from "../data/wrench_monitor.json";
import results from "../data/results.json";

const DATA = { box, heart, flashlight, monitor };
const KEYS = Object.keys(DATA);
---

<div class="viz-root not-prose my-6" data-wrench-plot>
  <script is:inline type="application/json" data-wrench-json set:html={JSON.stringify({ data: DATA, results })} />

  <div class="mb-3 flex flex-wrap items-center justify-center gap-2" role="group" aria-label="Object">
    {
      KEYS.map((k, i) => (
        <button
          type="button"
          data-obj={k}
          aria-pressed={i === 0 ? "true" : "false"}
          class="rounded-full px-3 py-1.5 text-sm font-medium transition-colors hover:bg-zinc-300 aria-pressed:bg-zinc-800 aria-pressed:text-white dark:hover:bg-zinc-600 dark:aria-pressed:bg-zinc-200 dark:aria-pressed:text-zinc-900"
        >
          {(DATA as any)[k].label}
        </button>
      ))
    }
  </div>

  <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
    <div class="rounded-xl border border-zinc-200 p-2 dark:border-zinc-700">
      <div class="px-2 pt-1 text-sm font-semibold">Applied wrench at the pivot, <span class="font-normal">in {"{O}"}</span></div>
      <div data-ts class="h-[400px] w-full" role="img" aria-label="Applied force and torque versus time, shaded by phase"></div>
    </div>
    <div class="rounded-xl border border-zinc-200 p-2 dark:border-zinc-700">
      <div class="px-2 pt-1 text-sm font-semibold">Pivot torque vs. tilt: <span class="font-normal">pull and return sweeps</span></div>
      <div data-tq class="h-[400px] w-full" role="img" aria-label="Pivot torque versus tilt angle for the pull and return sweeps with model fits"></div>
    </div>
  </div>

  <aside class="mt-4 rounded-xl border-l-4 border-amber-500 bg-amber-50 p-4 text-sm dark:bg-amber-950/30">
    <div class="mb-1 font-semibold">Pull and return sweeps</div>
    <p class="m-0 leading-relaxed text-zinc-700 dark:text-zinc-300">
      The pull (ARC) and return (UNARC) sweeps are fit separately, and the reported estimate is the average of the two.
      The table gives the error of each sweep alone and of the average, over all trials.
    </p>
    <div class="mt-3 overflow-x-auto">
      <table class="w-full border-collapse font-mono text-xs tabular-nums" data-sweep-table>
        <thead>
          <tr class="border-b border-zinc-300 text-left dark:border-zinc-600">
            <th class="py-1 pr-3 font-sans font-semibold">Relative error of trial mean</th>
            <th class="py-1 pr-3 text-right font-sans font-semibold">ARC only</th>
            <th class="py-1 pr-3 text-right font-sans font-semibold">UNARC only</th>
            <th class="py-1 text-right font-sans font-semibold">Averaged</th>
          </tr>
        </thead>
        <tbody></tbody>
      </table>
    </div>
  </aside>
</div>

<style>
  .viz-root {
    --surface-1: #fcfcfb;
    --text-primary: #0b0b0b;
    --text-secondary: #52514e;
    --grid: #e4e3df;
    --band: rgba(82, 81, 78, 0.07);
    --series-1: #2a78d6;
    --series-2: #eb6834;
    --series-3: #1baf7a;
  }
  @media (prefers-color-scheme: dark) {
    :root:where(:not([data-theme="light"])) .viz-root {
      --surface-1: #18181b;
      --text-primary: #ffffff;
      --text-secondary: #c3c2b7;
      --grid: #3f3f46;
      --band: rgba(195, 194, 183, 0.08);
      --series-1: #3987e5;
      --series-2: #d95926;
      --series-3: #199e70;
    }
  }
  :root[data-theme="dark"] .viz-root {
    --surface-1: #18181b;
    --text-primary: #ffffff;
    --text-secondary: #c3c2b7;
    --grid: #3f3f46;
    --band: rgba(195, 194, 183, 0.08);
    --series-1: #3987e5;
    --series-2: #d95926;
    --series-3: #199e70;
  }
</style>

<script>
  type Series = { theta: number[]; tau: number[] };
  type Plot = {
    label: string;
    timeseries: { t: number[]; Fx: number[]; Fz: number[]; tau: number[]; phases: { name: string; t0: number; t1: number }[] };
    torque: {
      arc: Series;
      unarc: Series;
      fit_theta: number[];
      fit_arc: number[];
      fit_unarc: number[];
      theta_star: { arc: number; unarc: number; avg: number; gt: number };
    };
  };
  type Stat = { err_pct: number };

  async function init(root: HTMLElement) {
    const { data, results } = JSON.parse(root.querySelector("[data-wrench-json]")!.textContent!) as {
      data: Record<string, Plot>;
      results: Record<string, { label: string; sweeps: Record<"m" | "zc", Record<"arc" | "unarc" | "avg", Stat>> }>;
    };
    const tsEl = root.querySelector<HTMLElement>("[data-ts]")!;
    const tqEl = root.querySelector<HTMLElement>("[data-tq]")!;
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>("button[data-obj]"));
    let current = Object.keys(data)[0];

    // Sweep table: all four objects, from all trials.
    const tbody = root.querySelector("[data-sweep-table] tbody")!;
    const fmt = (s: Stat) => s.err_pct.toFixed(1) + "%";
    for (const [k, r] of Object.entries(results)) {
      for (const [p, name] of [["m", "m"], ["zc", "z_c"]] as const) {
        const h = r.sweeps[p];
        const tr = document.createElement("tr");
        tr.dataset.obj = k;
        tr.className = "border-b border-zinc-200 dark:border-zinc-700";
        tr.innerHTML = `<td class="py-1 pr-3 font-sans">${r.label} · ${name}</td>` +
          `<td class="py-1 pr-3 text-right">${fmt(h.arc)}</td><td class="py-1 pr-3 text-right">${fmt(h.unarc)}</td>` +
          `<td class="py-1 text-right font-semibold">${fmt(h.avg)}</td>`;
        tbody.appendChild(tr);
      }
    }

    const css = (v: string) => getComputedStyle(root).getPropertyValue(v).trim();
    // Plotly (~1 MB) is fetched only once the plots scroll near the viewport.
    await new Promise<void>((resolve) => {
      const io = new IntersectionObserver((entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          io.disconnect();
          resolve();
        }
      }, { rootMargin: "400px" });
      io.observe(root);
    });
    const Plotly = (await import("plotly.js-basic-dist-min")).default;

    // Tabs may restore or change their selection before the lazy plot loads.
    const selectedObject = document.querySelector<HTMLElement>(
      '[data-sync-key="object"] [data-tabs-trigger][aria-selected="true"]',
    )?.dataset.value;
    if (selectedObject && selectedObject in data) current = selectedObject;

    function layoutBase() {
      const ink = css("--text-secondary");
      const axis = { gridcolor: css("--grid"), zerolinecolor: css("--grid"), linecolor: css("--grid"), tickfont: { color: ink, size: 11 }, title: { font: { color: ink, size: 12 } } };
      return {
        axis,
        base: {
          paper_bgcolor: "rgba(0,0,0,0)",
          plot_bgcolor: "rgba(0,0,0,0)",
          font: { family: "inherit", color: css("--text-primary") },
          margin: { l: 56, r: 12, t: 16, b: 44 },
          legend: { orientation: "h", y: -0.16, x: 0, font: { size: 11, color: ink } },
          hoverlabel: { bgcolor: css("--surface-1"), bordercolor: css("--grid"), font: { color: css("--text-primary") } },
        },
      };
    }

    function draw() {
      const d = data[current];
      const { axis, base } = layoutBase();
      const c1 = css("--series-1"), c2 = css("--series-2"), c3 = css("--series-3"), ink = css("--text-secondary");
      const ts = d.timeseries;

      // Phase bands, labeled once each at the top.
      const shapes: any[] = [];
      const annotations: any[] = [];
      ts.phases.forEach((p, i) => {
        if (i % 2 === 0) shapes.push({ type: "rect", xref: "x", yref: "paper", x0: p.t0, x1: p.t1, y0: 0, y1: 1, fillcolor: css("--band"), line: { width: 0 }, layer: "below" });
        if (p.t1 - p.t0 > 2.5) annotations.push({ x: (p.t0 + p.t1) / 2, y: 1.0, xref: "x", yref: "paper", yanchor: "bottom", text: p.name, showarrow: false, font: { size: 10, color: ink } });
      });

      const line = (color: string) => ({ color, width: 2 });
      Plotly.react(tsEl, [
        { x: ts.t, y: ts.Fx, name: "F<sub>x</sub> (N)", type: "scatter", mode: "lines", line: line(c1), xaxis: "x", yaxis: "y", hovertemplate: "%{y:.2f} N" },
        { x: ts.t, y: ts.Fz, name: "F<sub>z</sub> (N)", type: "scatter", mode: "lines", line: line(c2), xaxis: "x", yaxis: "y", hovertemplate: "%{y:.2f} N" },
        { x: ts.t, y: ts.tau, name: "tipping torque τ (N·m)", type: "scatter", mode: "lines", line: line(c3), xaxis: "x", yaxis: "y2", hovertemplate: "%{y:.3f} N·m" },
      ], {
        ...base,
        margin: { ...base.margin, t: 26 },
        hovermode: "x unified",
        grid: { rows: 2, columns: 1, pattern: "coupled", roworder: "top to bottom" },
        xaxis: { ...axis, title: { ...axis.title, text: "time in contact (s)" }, showspikes: true, spikemode: "across", spikethickness: 1, spikecolor: ink, spikedash: "solid" },
        yaxis: { ...axis, domain: [0.45, 1], title: { ...axis.title, text: "force (N)" } },
        yaxis2: { ...axis, domain: [0, 0.37], title: { ...axis.title, text: "torque (N·m)" } },
        shapes, annotations,
      }, { displayModeBar: false, responsive: true });

      const tq = d.torque;
      const ts_ = tq.theta_star;
      const ymax = Math.max(...tq.arc.tau, ...tq.unarc.tau);
      const vline = (x: number, dash: string, color: string) => ({ type: "line", x0: x, x1: x, yref: "paper", y0: 0, y1: 1, line: { color, width: 1.5, dash } });
      Plotly.react(tqEl, [
        { x: tq.arc.theta, y: tq.arc.tau, name: "pull (ARC)", type: "scatter", mode: "markers", marker: { color: c1, size: 8, line: { color: css("--surface-1"), width: 2 } }, hovertemplate: "θ %{x:.1f}°<br>τ %{y:.3f} N·m<extra>ARC</extra>" },
        { x: tq.unarc.theta, y: tq.unarc.tau, name: "return (UNARC)", type: "scatter", mode: "markers", marker: { color: c2, size: 8, line: { color: css("--surface-1"), width: 2 } }, hovertemplate: "θ %{x:.1f}°<br>τ %{y:.3f} N·m<extra>UNARC</extra>" },
        { x: tq.fit_theta, y: tq.fit_arc, name: "fit ARC", type: "scatter", mode: "lines", line: { color: c1, width: 2 }, hoverinfo: "skip", showlegend: false },
        { x: tq.fit_theta, y: tq.fit_unarc, name: "fit UNARC", type: "scatter", mode: "lines", line: { color: c2, width: 2, dash: "dash" }, hoverinfo: "skip", showlegend: false },
      ], {
        ...base,
        hovermode: "closest",
        xaxis: { ...axis, title: { ...axis.title, text: "object tilt θ (deg)" } },
        yaxis: { ...axis, title: { ...axis.title, text: "tipping torque (N·m)" } },
        shapes: [vline(ts_.avg, "solid", css("--text-primary")), vline(ts_.gt, "dot", ink)],
        annotations: [
          { x: ts_.avg, y: ymax, yanchor: "bottom", xanchor: "right", text: `θ* est ${ts_.avg.toFixed(2)}°`, showarrow: false, font: { size: 11, color: css("--text-primary") } },
          { x: ts_.gt, y: ymax * 0.85, xanchor: "left", text: ` GT ${ts_.gt.toFixed(2)}°`, showarrow: false, font: { size: 11, color: ink } },
        ],
      }, { displayModeBar: false, responsive: true });

      buttons.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.obj === current)));
      tbody.querySelectorAll<HTMLElement>("tr").forEach((tr) => tr.classList.toggle("bg-amber-100/70", tr.dataset.obj === current));
      tbody.querySelectorAll<HTMLElement>("tr").forEach((tr) => tr.classList.toggle("dark:bg-amber-900/30", tr.dataset.obj === current));
    }

    function select(key: string, broadcast: boolean) {
      if (!(key in data) || key === current) return;
      current = key;
      draw();
      if (broadcast) document.dispatchEvent(new CustomEvent("starwind-tabs-sync:object", { detail: { value: key } }));
    }

    buttons.forEach((b) => b.addEventListener("click", () => select(b.dataset.obj!, true)));
    document.addEventListener("starwind-tabs-sync:object", (e) => select((e as CustomEvent).detail.value, false));
    window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", draw);
    draw();
  }

  document.querySelectorAll<HTMLElement>("[data-wrench-plot]").forEach((root) => init(root));
</script>
