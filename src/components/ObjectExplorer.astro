---
// Tabbed explorer for the four benchmark objects: trial video, GT-vs-estimate table, and the
// edge case each object exercises. Numbers come from src/data/results.json, which
// code/tools/export_web_data.py generates from the released trial data.
import { Tabs, TabsList, TabsTrigger, TabsContent } from "./starwind/tabs";
import VideoCard from "./VideoCard.astro";
import results from "../data/results.json";

type Stat = { mean: number; sd: number; err_pct: number };
type Obj = {
  label: string;
  n_trials: number;
  gt: { m: number; zc: number; mu: number };
  est: { m: Stat; zc: Stat; mu: Stat };
};
const R = results as Record<string, Obj>;

const OBJECTS: { key: string; speed: string; tag: string; note: string }[] = [
  {
    key: "box",
    speed: "×7.5",
    tag: "Transparent rigid prism",
    note: "The baseline object. Its clear, textureless walls defeat vision-based tipping trackers, but the tilt here comes from proprioception, so the CoM height is recovered to within 1%.",
  },
  {
    key: "heart",
    speed: "×6.0",
    tag: "Lightweight, high press-to-pull ratio",
    note: "The hardest case and the largest error (15.1% in z_c). At 239 g the gravity torque is small, and the geometry needs a large press relative to the pull. Its pull and return sweeps agree closely and the trial spread is small, so the error is systematic, not noise.",
  },
  {
    key: "flashlight",
    speed: "×4.4",
    tag: "Curved, low-friction base",
    note: "A documented failure case for plain forward tipping: its round base swirls about the vertical axis near θ*. The press pins the pivot mechanically, and z_c comes back within a fraction of a percent.",
  },
  {
    key: "monitor",
    speed: "×9.0",
    tag: "5 kg payload, compliant",
    note: "At 5.04 kg and 0.53 m tall, it tests the top of the payload range. The large, clean torque signal gives the tightest spread (CV ≤ 0.22%), and its rubber feet give the highest μ_t. The screen flexes under load, and the adaptive press settles on a force where that flex is negligible.",
  },
];

const fmt = (x: number, d: number) => x.toFixed(d);
const errClass = (e: number) =>
  e < 5 ? "text-emerald-700 dark:text-emerald-400" : e < 10 ? "text-amber-700 dark:text-amber-400" : "text-red-700 dark:text-red-400";
---

<div class="not-prose my-6">
  <Tabs defaultValue="box" syncKey="object">
    <TabsList>
      {OBJECTS.map((o) => <TabsTrigger value={o.key}>{R[o.key].label}</TabsTrigger>)}
    </TabsList>
    {
      OBJECTS.map((o) => {
        const r = R[o.key];
        const rows = [
          { name: "Mass m", unit: "kg", gt: fmt(r.gt.m, 3), est: `${fmt(r.est.m.mean, 3)} ± ${fmt(r.est.m.sd, 3)}`, err: r.est.m.err_pct },
          { name: "CoM height z_c", unit: "cm", gt: fmt(r.gt.zc * 100, 2), est: `${fmt(r.est.zc.mean * 100, 2)} ± ${fmt(r.est.zc.sd * 100, 2)}`, err: r.est.zc.err_pct },
          { name: "Friction μ_t", unit: "", gt: fmt(r.gt.mu, 3), est: `${fmt(r.est.mu.mean, 3)} ± ${fmt(r.est.mu.sd, 3)}`, err: r.est.mu.err_pct },
        ];
        return (
          <TabsContent value={o.key}>
            <div class="grid grid-cols-1 items-start gap-6 md:grid-cols-2">
              <VideoCard src={`videos/${o.key}_trial.mp4`} poster={`posters/${o.key}_trial.jpg`} title={r.label} speed={o.speed}>
                One press-and-pull trial (press, pull, return), sped up. The overlay shows the live F/T reading.
              </VideoCard>
              <div class="flex flex-col gap-4">
                <span class="w-fit rounded-full bg-zinc-200 px-3 py-1 text-xs font-semibold text-zinc-700 dark:bg-zinc-700 dark:text-zinc-200">
                  {o.tag}
                </span>
                <div class="overflow-x-auto">
                  <table class="w-full border-collapse text-sm">
                    <thead>
                      <tr class="border-b border-zinc-300 text-left dark:border-zinc-600">
                        <th class="py-2 pr-3 font-semibold">Parameter</th>
                        <th class="py-2 pr-3 text-right font-semibold">Ground truth</th>
                        <th class="py-2 pr-3 text-right font-semibold">Estimate (N={r.n_trials})</th>
                        <th class="py-2 text-right font-semibold">Error of mean</th>
                      </tr>
                    </thead>
                    <tbody>
                      {rows.map((row) => (
                        <tr class="border-b border-zinc-200 dark:border-zinc-700">
                          <td class="py-2 pr-3">
                            {row.name} {row.unit && <span class="text-zinc-500">({row.unit})</span>}
                          </td>
                          <td class="py-2 pr-3 text-right font-mono tabular-nums">{row.gt}</td>
                          <td class="py-2 pr-3 text-right font-mono tabular-nums">{row.est}</td>
                          <td class:list={["py-2 text-right font-mono font-semibold tabular-nums", errClass(row.err)]}>
                            {fmt(row.err, 1)}%
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
                <p class="m-0 text-sm leading-relaxed text-zinc-700 dark:text-zinc-300">{o.note}</p>
                <p class="m-0 text-xs text-zinc-500 dark:text-zinc-400">
                  Estimate = mean ± SD across 10 trials; SD describes repeatability, not uncertainty. Error = |mean − ground truth| / ground truth. μ_t comes from one Mode 1 push and each trial's
                  recovered mass. Its ground truth is the same push resolved with the scale mass. Reproduce with{" "}
                  <code class="rounded bg-zinc-200 px-1 dark:bg-zinc-700">python run_offline_eval.py --object {o.key}</code>.
                </p>
              </div>
            </div>
          </TabsContent>
        );
      })
    }
  </Tabs>
</div>
